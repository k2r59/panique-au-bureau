{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panique-au-bureau",
  "account_id": "d5d57d15751e093b840fcd28077f1f1f",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "./build/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/play",
      "/play/",
      "/play/index.wasm",
      "/api/*"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "panique-au-bureau",
      "database_id": "44e6a57d-346a-4dab-82e9-4c226bde4b34",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "routes": [
    {
      "pattern": "panique.promo.dev",
      "custom_domain": true
    }
  ]
}
